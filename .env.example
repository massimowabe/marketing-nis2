# Configurazione Backend - Dipartimento 1 (Tech & Data)
# Rinomina questo file in ".env" e inserisci le tue chiavi reali.

# 1. SUPABASE (Database Reale)
# Registrati gratis su: https://supabase.com
VITE_SUPABASE_URL="inserisci_qui_la_tua_url"
VITE_SUPABASE_ANON_KEY="inserisci_qui_la_tua_anon_key"

# 2. EMAILJS (Notifiche Email)
# Registrati gratis su: https://www.emailjs.com
VITE_EMAILJS_SERVICE_ID="inserisci_service_id"
VITE_EMAILJS_TEMPLATE_ID="inserisci_template_id"
VITE_EMAILJS_PUBLIC_KEY="inserisci_public_key"
